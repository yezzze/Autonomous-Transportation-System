# 复制为 cluster.env 后按本机修改（cluster.env 不提交 git）
#   cp scripts/local/cluster.env.example scripts/local/cluster.env

# 本机所属边缘集群：a、b 或 c
LOCAL_CLUSTER=b

# 集群 A（云端 NATS Hub 默认部署在 A 宿主机）
CLUSTER_A_HOST=10.112.136.44
CLUSTER_A_EDGE_ID=edge-a

# 集群 B
CLUSTER_B_HOST=10.112.221.121
CLUSTER_B_EDGE_ID=edge-b

# 集群 C
CLUSTER_C_HOST=10.112.221.122
CLUSTER_C_EDGE_ID=edge-c

# 云端 Hub 地址（默认 CLUSTER_A_HOST，一般不用改）
# NATS_CLOUD_HOST=10.112.136.44

# leafnode 密码（须与 k8s/helm/nats-cloud-values.yaml 中一致）
NATS_CLOUD_PASSWORD=change-me-leaf-password

# 编排器为每个 Agent Pod UID 在所属边缘 domain 创建一个独立 Stream
# NATS_WORKFLOW_STREAM_PREFIX=WF
# NATS_STREAM_MAX_BYTES=512MiB
# NATS_STREAM_MAX_AGE=24h
# NATS_STREAM_MAX_MSGS=-1
# NATS_STREAM_MAX_MSGS_PER_SUBJECT=-1
# NATS_STREAM_DISCARD=new
# NATS_STREAM_RETENTION=workqueue
# NATS_STREAM_STORAGE=file
# NATS_FRAME_STREAM_PREFIX=FRAME
# NATS_FRAME_STREAM_MAX_BYTES=512MiB
# NATS_FRAME_STREAM_MAX_AGE_SEC=120
# NATS_FRAME_ACK_WAIT_SEC=60
# NATS_FRAME_MAX_DELIVER=3
# NATS_CONSUMER_MAX_INACTIVE=10m
# NATS_CLEAN_CONSUMERS_ON_START=false

# 云端 Hub 默认不创建共享 WORKFLOW Stream
# NATS_CREATE_CLOUD_WORKFLOW_STREAM=false

# 可选
# NATS_EDGE_NAMESPACE=default
# NATS_EDGE_RELEASE=nats
# MINIKUBE_PROFILE=minikube
