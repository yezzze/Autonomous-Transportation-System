      "status": "online",
      "description": "读取自车原始点云数据，使用Where2comm算法转换为中间通信特征的 Agent",
      "enabled": true,
      "priority": 10,
      "tags": ["perception", "intermediate_feature", "vehicle", "cooperative"],
      "node_name": "minikube",
      "is_local": true
    },
    {
      "id": "simlingo-encoder-agent",
      "ip": "192.168.49.2",
      "port": 30121,
      "capability": "simlingoEncoder",
      "type": "business",
      "status": "online",
      "description": "SimLingo 编码器 Agent，用于将输入数据编码为 SimLingo 格式",
      "enabled": true,
      "priority": 10,
      "tags": ["simlingo", "encoder"],
      "node_name": "minikube",
      "is_local": true
    },
    {
      "id": "vogs-ego-agent",
      "ip": "192.168.49.2",
      "port": 30192,
      "capability": "vogsEgo",
      "type": "business",
      "status": "online",
      "description": "Vogs Ego Agent，使用Vogs算法，用于处理自车的感知和决策，可以接受来自其他协同车辆的高斯表征数据",
