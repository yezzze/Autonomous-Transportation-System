{
  "version": "1.0",
  "description": "LangManus Agent Registry Configuration - 分布式 Agent 部署配置",
  "registry_type": "file",
  "agents": [
    {
      "id": "perception2intermediatefeature-agent",
      "ip": "192.168.49.2",
