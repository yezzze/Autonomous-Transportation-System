      "priority": 10,
      "tags": ["vogs", "ego"],
      "node_name": "minikube",
      "is_local": true
    },
    {
      "id": "cloudvlmacccidentdescription-agent",
      "ip": "192.168.49.2",
      "port": 30133,
      "capability": "cloudVlmAccidentDescription",
      "type": "business",
      "status": "online",
      "description": "Cloud VLM Accident Description Agent，可以接收来自路侧的压缩后的token序列，用于生成事故的详细描述",
      "enabled": true,
      "priority": 10,
      "tags": ["cloud", "vlm", "accident", "description"],
      "node_name": "minikube",
      "is_local": true
    }
  ],
  "_comments": {
    "configuration_notes": "这是分布式 Agent 注册表配置文件",
    "deployment_architecture": "Layer 2 Scheduler (Web UI) 部署在容器中，Layer 3 Agents 分布在不同的远程节点",
    "current_configuration": "混合部署模式 - search_agent_001 在本地 (127.0.0.1)，其他 Agent 在远程节点",
    "how_to_configure": [
      "1. 本地 Agent 使用 127.0.0.1 或 localhost",
      "2. 远程 Agent 填入真实 IP 地址 (如 192.168.1.102)",
      "3. 确保端口没有被占用",
      "4. 设置 'enabled' 为 true 以启用该 Agent",
      "5. 'priority' 数字越大优先级越高"
    ],
    "example_local_testing": "本地测试：将所有 IP 改为 127.0.0.1，端口使用 8080-8085",
    "example_distributed": "纯分布式：所有 Agent 填入远程 IP，例如：192.168.1.101, 10.0.0.15, node01.company.com",
    "example_hybrid": "混合部署（当前配置）：部分 Agent 在本地 (127.0.0.1)，部分在远程节点"
  }
}
