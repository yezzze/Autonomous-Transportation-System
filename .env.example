# ===== LLM 配置 =====

# 推理模型（用于 Planner）
REASONING_API_KEY=sk-31be252e9dcf413ea4a9ac05ac8b4594          # 替换为你的真实 Key
REASONING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=qwen3.5-flash

# 基础模型（用于 Coordinator/Supervisor/Reporter）
BASIC_API_KEY=sk-31be252e9dcf413ea4a9ac05ac8b4594            # 可以和推理模型用同一个 Key
BASIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BASIC_MODEL=qwen3.5-flash

# 视觉模型（用于 Browser Agent）
VL_API_KEY=sk-31be252e9dcf413ea4a9ac05ac8b4594             # 可以和上面用同一个 Key
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-image-2.0-pro

# ===== 应用配置 =====
DEBUG=True                                       # 开发环境用 True
APP_ENV=development                              # 环境：development/production

# ===== LLM 智能体模拟器配置 =====
# 是否使用 LLM 模拟智能体（推荐启用，获得更真实的响应）
USE_LLM_SIMULATOR=true                          # true: 使用 LLM 模拟 | false: 使用固定 Mock 数据

# LLM 模拟器使用的模型类型
LLM_SIMULATOR_MODEL=basic                       # basic: 快速模型（qwen-flash）| reasoning: 推理模型（更强但更慢）

# ===== 第三方服务 =====
TAVILY_API_KEY=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            # 替换为你的 Tavily Key

# Chrome 路径（macOS）
EDGE_INSTANCE_PATH=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge

# Chrome 路径（Windows）
# CHROME_INSTANCE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Chrome 路径（Linux）
# CHROME_INSTANCE_PATH=/usr/bin/google-chrome